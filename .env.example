# ─────────────────────────────────────────────────────────────────────────────
# Kus AI — Environment Variables
# Copy to `.env.local` (dev) and configure the same keys in Vercel's dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (auth / DB / telemetry / billing) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── App identity ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://kus-ai-app.vercel.app
NEXT_PUBLIC_APP_URL=https://kus-ai-app.vercel.app
NEXT_PUBLIC_APP_NAME=Kus-Lords / Kus AI

# ── Hub / companion deep links ───────────────────────────────────────────────
NEXT_PUBLIC_HUB_URL=https://sport-clan-nexus.vercel.app
NEXT_PUBLIC_SPORTS_COMPANION_URL=https://kus-sports.vercel.app

# ═════════════════════════════════════════════════════════════════════════════
# UNIVERSAL AI GATEWAY (src/server/ai-gateway)
#
# Switch the whole app's AI routing platform with one variable. No code change
# required — every platform speaks the OpenAI-compatible chat.completions API.
# ═════════════════════════════════════════════════════════════════════════════
# openrouter | vercel | litellm | portkey | braintrust | direct
AI_GATEWAY_PROVIDER=openrouter

# Override the platform base URL (required for self-hosted LiteLLM / your
# Vercel/Cloudflare gateway URL; optional for the defaults below).
#AI_GATEWAY_BASE_URL=https://gateway.example.com/v1

# Gateway API key. For `direct` this falls back to the per-provider key below.
#AI_GATEWAY_API_KEY=

# Primary + fallback models used when a request omits `model`.
#AI_PRIMARY_MODEL=openrouter/free
#AI_FALLBACK_MODELS=openrouter/free,google/gemini-2.5-flash,openai/gpt-4o-mini

# Resilience tunables.
#AI_MAX_RETRIES=3
#AI_REQUEST_TIMEOUT_MS=60000

# Per-request telemetry (tokens, cost, latency) → ai_usage_requests table.
#AI_TELEMETRY_ENABLED=true

# Optional flat per-1M-token USD price overrides (unified billing rate).
#AI_PRICE_INPUT_PER_1M=1
#AI_PRICE_OUTPUT_PER_1M=3

# ── Direct provider selection (when AI_GATEWAY_PROVIDER=direct) ──────────────
# openai | groq | together | deepseek | mistral | cohere | perplexity | gemini
#AI_DIRECT_PROVIDER=openai

# ── Virtual / sub-key management (src/server/ai-gateway/virtual-keys.ts) ─────
# Set to provision real per-user sub-keys with USD budget ceilings via the
# OpenRouter Management API (https://openrouter.ai/settings/api-keys → create
# a "Management" key).
#OPENROUTER_MANAGEMENT_KEY=

# ── Platform / aggregator keys (existing router + BYOK fallbacks) ────────────
OPENROUTER_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#GROQ_API_KEY=
#TOGETHER_API_KEY=
#DEEPSEEK_API_KEY=
#MISTRAL_API_KEY=
#COHERE_API_KEY=
#PERPLEXITY_API_KEY=
#DEEPINFRA_API_KEY=

# Optional paid host switches used by the IDE "push to host" flow.
#VERCEL_DEPLOY_HOOK_URL=
#NETLIFY_BUILD_HOOK=
#RAILWAY_DEPLOY_HOOK=
#HOST_DEPLOY_HOOK_URL=

# ── Credit billing tariffs (existing ai_credit_* system) ─────────────────────
#AI_INPUT_CREDITS_PER_1K=0.02
#AI_OUTPUT_CREDITS_PER_1K=0.08
#AI_FLAGSHIP_MULTIPLIER=4

# ── E2B cloud sandbox (autonomous verification) ──────────────────────────────
#E2B_API_KEY=

# ── Push notifications (VAPID) ───────────────────────────────────────────────
#NEXT_PUBLIC_VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:team@kus-lords.app

# ── Kus AI / Kus Code backend pipelines ──────────────────────────────────────
#KUS_AI_API_KEY=
#KUS_CODE_API_KEY=

# ── GitHub App (for Jyinx autonomous agent) ──────────────────────────────────
# Create a GitHub App at https://github.com/settings/apps
# Generate a private key, set the webhook URL, and note the App ID.
#GH_APP_ID=
#GH_APP_PRIVATE_KEY=
#GH_APP_CLIENT_ID=
#GH_APP_CLIENT_SECRET=
#GH_APP_INSTALL_URL=https://github.com/apps/jyinx-bot/installations/new